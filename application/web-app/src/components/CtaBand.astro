---

<section id="cta" class="mx-auto max-w-6xl px-6 pb-24">
  <div
    class="hero rounded-2xl border border-base-300 bg-base-200 text-base-content"
  >
    <div class="hero-content py-16 text-center">
      <div class="max-w-xl">
        <h2 class="text-3xl font-bold md:text-4xl">
          Put time tracking your team will actually use.
        </h2>
        <p class="mt-4 opacity-80">
          Get started in minutes — invite your team, create a project, and start
          the timer. No credit card required.
        </p>
        <form class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <input
            type="email"
            required
            placeholder="you@company.com"
            class="input input-bordered w-full text-base-content sm:max-w-xs"
          />
          <button type="submit" class="btn btn-primary">Start free</button>
        </form>
      </div>
    </div>
  </div>
</section>
