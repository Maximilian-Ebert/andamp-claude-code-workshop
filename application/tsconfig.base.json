{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@lib": ["shared/lib/src/index.ts"],
      "@lib/*": ["shared/lib/src/*"],
      "@data": ["shared/data/src/index.ts"],
      "@data/*": ["shared/data/src/*"]
    }
  }
}
